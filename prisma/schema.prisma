generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               String
  businessName       String?
  phone              String?
  sport              String?
  school             String?
  athleteLevel       String?
  city               String?
  bio                String?
  instagramHandle    String?
  tiktokHandle       String?
  twitterHandle      String?
  youtubeHandle      String?
  username           String?  @unique
  profileToken       String?  @unique
  profilePhoto       String?
  isActive           Boolean  @default(true)
  subscriptionPlan   String   @default("free")
  subscriptionStatus String   @default("inactive")
  stripeCustomerId     String?
  stripeAccountId      String?
  stripeSubscriptionId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  dealsOwned    Deal[]           @relation("BusinessDeals")
  dealsReceived Deal[]           @relation("AthleteDeals")
  invitations   DealInvitation[]
  messages      Message[]
  notifications Notification[]
  savedAthletes SavedAthlete[]   @relation("BusinessSaves")
  savesReceived SavedAthlete[]   @relation("AthleteSaves")
  auditLogs      AuditLog[]
  passwordResets PasswordReset[]
  claimedListing DirectoryListing?
  introRequests  IntroRequest[] @relation("BusinessIntros")
  introSubjects  IntroRequest[] @relation("AthleteIntros")
}

model DirectoryListing {
  id            String   @id @default(cuid())
  name          String
  level         String
  sport         String
  squad         String?
  position      String?
  teamOrSchool  String
  city          String?
  state         String?
  status         String    @default("listed")
  email          String?   @unique
  claimTokenHash String?   @unique
  claimExpiresAt DateTime?
  claimedUserId  String?   @unique
  claimedUser   User?    @relation(fields: [claimedUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  interests     IntroRequest[]

  @@index([level, sport])
  @@index([city])
}

model IntroRequest {
  id         String            @id @default(cuid())
  businessId String
  business   User              @relation("BusinessIntros", fields: [businessId], references: [id], onDelete: Cascade)
  listingId  String?
  listing    DirectoryListing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  athleteId  String?
  athlete    User?             @relation("AthleteIntros", fields: [athleteId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime          @default(now())

  @@index([businessId])
  @@index([listingId])
  @@index([athleteId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  summary    String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

model SavedAthlete {
  id         String   @id @default(cuid())
  businessId String
  athleteId  String
  business   User     @relation("BusinessSaves", fields: [businessId], references: [id], onDelete: Cascade)
  athlete    User     @relation("AthleteSaves", fields: [athleteId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([businessId, athleteId])
}

model Deal {
  id                 String    @id @default(cuid())
  businessId         String
  business           User      @relation("BusinessDeals", fields: [businessId], references: [id])
  athleteId          String?
  athlete            User?     @relation("AthleteDeals", fields: [athleteId], references: [id])
  dealType           String
  platforms          String?
  compensationAmount Float
  platformFeeAmount  Float     @default(0)
  athleteFeeAmount   Float     @default(0)
  athleteNetPayout   Float     @default(0)
  startsAt           DateTime?
  deadline           DateTime?
  notes              String?
  deliverables       String?
  status                  String    @default("pending")
  paymentStatus           String    @default("unpaid")
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeTransferId        String?
  stripeInvoiceId         String?
  paidAt                  DateTime?
  token                   String    @unique
  archivedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  invitations DealInvitation[]
  messages    Message[]
}

model DealInvitation {
  id           String   @id @default(cuid())
  dealId       String
  deal         Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  athleteEmail String
  athleteId    String?
  athlete      User?    @relation(fields: [athleteId], references: [id])
  token        String   @unique
  status       String   @default("pending")
  createdAt    DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?    @relation(fields: [senderId], references: [id])
  body      String
  system    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FeeSchedule {
  id            String   @id
  freePercent   Float
  proPercent    Float
  growthPercent Float
  updatedAt     DateTime @updatedAt
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}
